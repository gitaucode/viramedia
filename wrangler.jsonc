{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viramedia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "VIRA_DB",
      "database_name": "vira-creators",
      "database_id": "a1af07f4-40b7-4a31-a536-1f36b7b0de6b"
    }
  ],
  "observability": {
    "enabled": true
  }
}
