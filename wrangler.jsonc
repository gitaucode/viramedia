{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viramedia",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "VIRA_DB",
      "database_name": "vira-creators",
      "database_id": "a1af07f4-40b7-4a31-a536-1f36b7b0de6b"
    }
  ],
  "vars": {
    "VIRA_SITE_URL": "https://viramedia.stephen-gitau.workers.dev"
  },
  "triggers": {
    "crons": ["0 5 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
